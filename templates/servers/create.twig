{% extends "layout.twig" %}
{% block title %}Add Server{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold mb-8"><i class="fas fa-plus-circle text-purple-600"></i> Add New Server</h1>
  {% if error %}<div class="mb-4 bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded">{{ error }}</div>{% endif %}
  <form method="POST" enctype="multipart/form-data" class="bg-white shadow rounded-lg p-6 space-y-6">
    <div><label class="block text-sm font-medium text-gray-700">Server Name</label><input name="name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="US Server 1"></div>
    <div><label class="block text-sm font-medium text-gray-700">{{ t('servers.protocol') }}</label>
      <select name="protocol" id="protocol" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" onchange="toggleProtocolFields()">
        <option value="awg">{{ t('servers.protocol_awg') }}</option>
        <option value="vless_reality">{{ t('servers.protocol_vless') }}</option>
      </select>
    </div>
    <div><label class="block text-sm font-medium text-gray-700">Host IP/Domain</label><input name="host" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" placeholder="123.456.789.0"></div>
    <div id="awgFields" class="space-y-6">
    <div><label class="block text-sm font-medium text-gray-700">SSH Port</label><input name="port" id="portField" type="number" value="22" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></div>
    <div><label class="block text-sm font-medium text-gray-700">SSH Username</label><input name="username" id="usernameField" value="root" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></div>
    </div>
    <div id="vlessFields" class="space-y-4" style="display:none;">
      <p class="text-sm text-gray-600">{{ t('servers.xui_hint') }}</p>
      <div><label class="block text-sm font-medium text-gray-700">{{ t('servers.xui_port') }}</label><input name="port_xui" id="portXui" type="number" value="2053" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></div>
      <div><label class="block text-sm font-medium text-gray-700">{{ t('servers.xui_user') }}</label><input name="username_xui" id="usernameXui" value="admin" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></div>
      <div><label class="block text-sm font-medium text-gray-700">{{ t('servers.xui_web_path') }}</label><input name="panel_web_path" placeholder="secret" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"><p class="mt-1 text-xs text-gray-500">If the panel URL is https://ip:2053/secret/ — enter secret</p></div>
      <div><label class="block text-sm font-medium text-gray-700">{{ t('servers.xui_inbound_id') }}</label><input name="xui_inbound_id" type="number" min="1" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></div>
      <label class="flex items-center text-sm"><input type="checkbox" name="panel_use_https" value="1" class="mr-2"> {{ t('servers.xui_https') }}</label>
      <label class="flex items-center text-sm"><input type="checkbox" name="panel_insecure_tls" value="1" class="mr-2" checked> {{ t('servers.xui_insecure') }}</label>
    </div>
    <div><label class="block text-sm font-medium text-gray-700" id="passwordLabel">SSH Password</label><input name="password" type="password" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></div>
    
    <!-- Import from existing panel -->
    <div id="importBlock" class="border-t pt-6">
      <div class="flex items-center mb-4">
        <input type="checkbox" id="enableImport" name="enable_import" class="h-4 w-4 text-purple-600 rounded" onchange="toggleImportFields()">
        <label for="enableImport" class="ml-2 text-sm font-medium text-gray-700">
          {{ t('servers.import_from_panel') }}
        </label>
      </div>
      
      <div id="importFields" style="display: none;" class="space-y-4 pl-6 border-l-2 border-purple-200">
        <div>
          <label class="block text-sm font-medium text-gray-700">{{ t('servers.select_panel_type') }}</label>
          <select name="panel_type" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="">-- {{ t('servers.select_panel_type') }} --</option>
            <option value="wg-easy">{{ t('servers.panel_type_wgeasy') }}</option>
            <option value="3x-ui">{{ t('servers.panel_type_3xui') }}</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700">{{ t('servers.upload_backup_file') }}</label>
          <input type="file" name="backup_file" accept=".json" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
          <p class="mt-1 text-xs text-gray-500">
            wg-easy: db.json | 3x-ui: export.json
          </p>
        </div>
      </div>
    </div>
    
    <button type="submit" class="w-full gradient-bg text-white py-2 px-4 rounded-md hover:opacity-90">
      <i class="fas fa-save mr-2"></i>Create Server
    </button>
  </form>
</div>

<script>
function toggleImportFields() {
  const checkbox = document.getElementById('enableImport');
  const fields = document.getElementById('importFields');
  fields.style.display = checkbox.checked ? 'block' : 'none';
}
function toggleProtocolFields() {
  const vless = document.getElementById('protocol').value === 'vless_reality';
  document.getElementById('awgFields').style.display = vless ? 'none' : 'block';
  document.getElementById('vlessFields').style.display = vless ? 'block' : 'none';
  document.getElementById('importBlock').style.display = vless ? 'none' : 'block';
  document.getElementById('passwordLabel').textContent = vless ? '{{ t("servers.xui_password") }}' : 'SSH Password';
}
toggleProtocolFields();
</script>

{% endblock %}
