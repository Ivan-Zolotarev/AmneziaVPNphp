{% extends "layout.twig" %}
{% block title %}{{ group.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-6">
    <a href="/groups" class="text-sm text-purple-600 hover:text-purple-800"><i class="fas fa-arrow-left mr-1"></i>{{ t('groups.back') }}</a>
    <div class="flex items-center gap-3 mt-2">
      <h1 class="text-3xl font-bold">{{ group.name }}</h1>
      {% if group.status == 'active' %}
        <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs">{{ t('status.active') }}</span>
      {% else %}
        <span class="px-2 py-1 bg-red-100 text-red-800 rounded text-xs">{{ t('status.disabled') }}</span>
      {% endif %}
    </div>
    {% if group.comment %}<p class="text-gray-600">{{ group.comment }}</p>{% endif %}
  </div>

  {% if success %}
  <div class="mb-6 bg-green-50 border-green-400 text-green-700 border px-4 py-3 rounded">
    <i class="fas fa-check-circle mr-2"></i>{{ success }}
  </div>
  {% endif %}
  {% if error %}
  <div class="mb-6 bg-red-50 border-red-400 text-red-700 border px-4 py-3 rounded">
    <i class="fas fa-exclamation-circle mr-2"></i>{{ error }}
  </div>
  {% endif %}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded shadow p-6">
      <h3 class="font-bold mb-4">{{ t('groups.group') }}</h3>
      <form method="POST" action="/groups/{{ group.id }}/update" class="space-y-3">
        <input name="name" value="{{ group.name }}" required class="w-full px-3 py-2 border rounded" placeholder="{{ t('groups.name') }}">
        <input name="comment" value="{{ group.comment }}" class="w-full px-3 py-2 border rounded" placeholder="{{ t('groups.comment') }}">
        <button type="submit" class="gradient-bg text-white px-4 py-2 rounded">{{ t('groups.save') }}</button>
      </form>
      <div class="mt-4 pt-4 border-t flex flex-wrap gap-3">
        {% if group.status == 'active' %}
        <form method="POST" action="/groups/{{ group.id }}/disable">
          <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded" onclick="return confirm('{{ t('groups.disable_confirm')|e('js') }}')">
            <i class="fas fa-ban mr-1"></i>{{ t('groups.disable') }}
          </button>
        </form>
        {% else %}
        <form method="POST" action="/groups/{{ group.id }}/enable">
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded">
            <i class="fas fa-play mr-1"></i>{{ t('groups.enable') }}
          </button>
        </form>
        {% endif %}
        <form method="POST" action="/groups/{{ group.id }}/delete">
          <button type="submit" class="text-red-600 hover:text-red-800 px-4 py-2" onclick="return confirm('{{ t('groups.delete_confirm')|e('js') }}')">{{ t('clients.delete') }}</button>
        </form>
      </div>
    </div>

    <div class="bg-white rounded shadow p-6">
      <h3 class="font-bold mb-4">{{ t('groups.add_existing') }}</h3>
      {% if ungrouped|length > 0 %}
      <form method="POST" action="/groups/{{ group.id }}/members/add" class="flex gap-3">
        <select name="client_id" required class="flex-1 px-3 py-2 border rounded">
          {% for c in ungrouped %}
          <option value="{{ c.id }}">{{ c.name }}{% if c.server_name %} — {{ c.server_name }}{% endif %}</option>
          {% endfor %}
        </select>
        <button type="submit" class="gradient-bg text-white px-4 py-2 rounded">{{ t('groups.add') }}</button>
      </form>
      {% else %}
      <p class="text-gray-500 text-sm">{{ t('clients.no_clients') }}</p>
      {% endif %}
    </div>
  </div>

  <div class="bg-white rounded shadow">
    <div class="px-6 py-4 border-b">
      <h3 class="font-bold">{{ t('groups.members') }} ({{ members|length }})</h3>
    </div>
    {% if members|length > 0 %}
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.name') }}</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('menu.servers') }}</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.status') }}</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.expiration') }}</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.last_handshake') }}</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('clients.actions') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for m in members %}
        <tr class="border-t">
          <td class="px-6 py-4"><a href="/clients/{{ m.id }}" class="text-purple-600 hover:text-purple-800">{{ m.name }}</a></td>
          <td class="px-6 py-4 text-sm text-gray-600">{{ m.server_name }}</td>
          <td class="px-6 py-4">
            {% if m.status == 'active' %}
              <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs">{{ t('status.active') }}</span>
            {% else %}
              <span class="px-2 py-1 bg-red-100 text-red-800 rounded text-xs">{{ t('status.disabled') }}</span>
              {% if m.disabled_by_group %}<div class="text-xs text-gray-500 mt-1">{{ t('groups.disabled_by_group') }}</div>{% endif %}
            {% endif %}
          </td>
          <td class="px-6 py-4 text-sm">
            {% if m.expires_at %}{{ m.expires_at|date('Y-m-d') }}{% else %}<span class="text-gray-400">{{ t('clients.never_expires') }}</span>{% endif %}
          </td>
          <td class="px-6 py-4 text-sm">
            {% if m.last_handshake %}{{ m.last_handshake }}{% else %}<span class="text-gray-400">{{ t('clients.never') }}</span>{% endif %}
          </td>
          <td class="px-6 py-4">
            <form method="POST" action="/clients/{{ m.id }}/group" style="display:inline;">
              <input type="hidden" name="group_id" value="">
              <input type="hidden" name="return_to" value="/groups/{{ group.id }}">
              <button type="submit" class="text-gray-600 hover:text-gray-800">{{ t('groups.remove') }}</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="p-12 text-center text-gray-500">{{ t('clients.no_clients') }}</div>
    {% endif %}
  </div>
</div>
{% endblock %}
